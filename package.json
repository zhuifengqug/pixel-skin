{
  "name": "dsh-pixel-skin",
  "version": "2.1.4",
  "description": "DeepSeek Harness 的宝可梦风像素皮肤：能力等级面板、推理档位补全、四色主题、像素字体、HP 段与 GBA 窗框；桌面端（Electron/Windows 自绘标题栏）适配。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "echo 'pre-built plain JS bundle — no build step required'"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "pixel",
    "famicom",
    "skin",
    "palette",
    "8-bit",
    "arcade"
  ],
  "author": "dsh user",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "sessions",
        "remote"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh": "^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.1.7-rc.1 || ^0.1.7"
  }
}
